---
import type { Post, Section } from '../lib/sections';
import { sectionHref } from '../lib/sections';
import { fmtDate } from '../lib/format';
import { img } from '../lib/img';
interface Props { post: Post; section?: Section; lead?: boolean; }
const { post, section, lead = false } = Astro.props;
const a = post.data;
const href = `/${post.id}/`;
---
<article class={'card' + (lead ? ' card--lead' : '')} data-level={section?.slug}>
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    <img src={img(a.image, lead ? 1200 : 700)} alt="" loading="lazy" decoding="async" width="800" height="450" />
  </a>
  <div class="card__body">
    {section ? <a class="card__kicker" href={sectionHref(section)}>{section.name}</a> : <span class="card__kicker">{a.category}</span>}
    <h3 class="card__title"><a href={href}>{a.title}</a></h3>
    <p class="card__excerpt">{a.excerpt}</p>
    <div class="card__meta">
      <time datetime={a.date.toISOString()}>{fmtDate(a.date)}</time>
      <span class="dot" aria-hidden="true">&middot;</span>
      <span>{a.readTime} read</span>
    </div>
  </div>
</article>
