---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist on Bazaar School." noindex={true}>
  <div class="center-page">
    <p class="eyebrow">Error 404</p>
    <h1>No lesson at this address.</h1>
    <p>The link may be old, or the page may have moved. The curriculum lists everything we have.</p>
    <div class="hero__actions" style="justify-content:center">
      <a class="btn btn--ink" href="/curriculum/">Open the curriculum</a>
      <a class="btn btn--ghost" href="/">Back to home</a>
    </div>
  </div>
</Base>
