---
import '../styles/global.css';
import { SITE, ADS } from '../data/site';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import Newsletter from '../components/Newsletter.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  /** Title for link previews on WhatsApp, X, Facebook and LinkedIn; defaults to the page title. */
  shareTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  active?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  level?: string;
}
const {
  title,
  shareTitle,
  description = SITE.tagline,
  image = '/images/og-default.jpg',
  type = 'website',
  active = '',
  noindex = false,
  jsonLd,
  level = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
// Google shows about 60 characters of a title, so a long title drops the "| Bazaar School" ending.
const branded = `${title} | ${SITE.name}`;
const fullTitle = title === SITE.name ? `${SITE.name}: learn the Indian stock market in order` : branded.length <= 60 ? branded : title;
const socialTitle = shareTitle || fullTitle;

// Google shows about 155 characters of a description. A longer one is cut after the
// last full sentence that fits, or else at a word break with an ellipsis.
function clip(text: string, max: number): string {
  const t = text.replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  const head = t.slice(0, max);
  const stop = Math.max(head.lastIndexOf('. '), head.lastIndexOf('? '), head.lastIndexOf('! '));
  if (stop >= max / 2) return head.slice(0, stop + 1);
  const space = head.lastIndexOf(' ', max - 2);
  return head.slice(0, space > 0 ? space : max - 1).replace(/[\s,;:.]+$/, '') + '…';
}
const metaDescription = clip(description, 160);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0F2E25" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Martel:wght@700;800;900&display=swap" rel="stylesheet" />

    <script is:inline>
      (function () { var t = localStorage.getItem('bs_theme') || 'light'; document.documentElement.setAttribute('data-theme', t); })();
    </script>
    {ld.map((obj) => <script type="application/ld+json" is:inline set:html={JSON.stringify(obj)} />)}
    {ADS.adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body data-level={level || undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead active={active} />
    <main id="main">
      <slot />
    </main>
    <Newsletter />
    <Footer />
    <SiteScripts />
    <Analytics />
    <CookieConsent />
  </body>
</html>
